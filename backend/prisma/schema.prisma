generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SYSTEM_ADMIN
  ADMIN
  DOCTOR
  NURSE
  LAB_TECH
}

enum SepsisRiskLevel {
  STABLE
  MODERATE
  HIGH
  CRITICAL
}

enum BedStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum NotificationType {
  CRITICAL_ALERT
  DOCTOR_ORDER_REQUEST
  LAB_RESULT_READY
  SYSTEM_INFO
}

enum DocType {
  LAB_REPORT
  IMAGING_CXR
  CT_SCAN
  OPERATIVE_NOTE
  DISCHARGE_SUMMARY
}

model Hospital {
  id           String       @id @default(uuid())
  name         String
  address      String
  city         String
  state        String
  country      String       @default("USA")
  phone        String
  bedCapacity  Int          @default(100)
  wardCapacity Int          @default(10)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  departments  Department[]
  users        User[]
  patients     Patient[]

  @@index([name])
}

model Department {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name       String
  code       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  wards      Ward[]
  users      User[]

  @@index([hospitalId, name])
}

model Ward {
  id               String     @id @default(uuid())
  departmentId     String
  department       Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name             String
  wardType         String
  capacity         Int        @default(20)
  currentOccupancy Int        @default(0)
  floorNumber      Int        @default(1)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  beds             Bed[]
  patients         Patient[]

  @@index([departmentId, name])
}

model Bed {
  id          String    @id @default(uuid())
  wardId      String
  ward        Ward      @relation(fields: [wardId], references: [id], onDelete: Cascade)
  bedNumber   String
  status      BedStatus @default(VACANT)
  isIsolated  Boolean   @default(false)
  patientId   String?   @unique
  patient     Patient?  @relation(fields: [patientId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([wardId, status])
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role        @default(DOCTOR)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  hospitalId   String?
  hospital     Hospital?   @relation(fields: [hospitalId], references: [id])
  profileImage String?
  status       String      @default("ACTIVE")
  lastLogin    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  patientsAttending Patient[]          @relation("AttendingDoctor")
  patientsNursing   Patient[]          @relation("PrimaryNurse")
  vitalsRecorded    VitalSign[]        @relation("VitalRecorder")
  labsUploaded      LaboratoryReport[] @relation("LabUploader")
  prescriptions     Medication[]       @relation("PrescribingDoctor")
  clinicalNotes     ClinicalNote[]     @relation("NoteAuthor")
  documentsUploaded Document[]         @relation("DocUploader")
  notifications     Notification[]     @relation("NotificationRecipient")
  auditLogs         AuditLog[]

  @@index([email, role])
  @@index([hospitalId])
}

model Patient {
  id                String          @id @default(uuid())
  hospitalId        String
  hospital          Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  mrn               String          @unique
  name              String
  age               Int
  gender            String
  bloodGroup        String?
  height            Float?
  weight            Float?
  primaryDiagnosis  String          @default("Post-op Care")
  medicalHistory    String          @default("[]")
  allergiesJson     String          @default("[]")
  chronicDiseases   String          @default("[]")
  emergencyContacts String          @default("[]")
  admissionDate     DateTime        @default(now())
  dischargeDate     DateTime?
  wardId            String?
  ward              Ward?           @relation(fields: [wardId], references: [id])
  bedNumber         String?
  attendingDoctorId String?
  attendingDoctor   User?           @relation("AttendingDoctor", fields: [attendingDoctorId], references: [id])
  primaryNurseId    String?
  primaryNurse      User?           @relation("PrimaryNurse", fields: [primaryNurseId], references: [id])
  qrCodeUrl         String?
  riskLevel         SepsisRiskLevel @default(STABLE)
  currentStatus     String          @default("Admitted")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  bed               Bed?
  vitals            VitalSign[]
  labs              LaboratoryReport[]
  predictions       AIPrediction[]
  alerts            AlertEscalation[]
  medications       Medication[]
  clinicalNotes     ClinicalNote[]
  documents         Document[]

  @@index([mrn])
  @@index([hospitalId, riskLevel])
  @@index([wardId])
}

model VitalSign {
  id              String   @id @default(uuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  temperature     Float
  heartRate       Float
  sysBP           Float
  diaBP           Float
  respRate        Float
  spo2            Float
  glucose         Float?
  urineOutput     Float?
  recordedById    String?
  recordedBy      User?    @relation("VitalRecorder", fields: [recordedById], references: [id])
  missingDataFlag Boolean  @default(false)
  notes           String?
  timestamp       DateTime @default(now())

  @@index([patientId, timestamp])
}

model LaboratoryReport {
  id                 String   @id @default(uuid())
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  wbc                Float
  platelets          Float
  lactate            Float
  procalcitonin      Float?
  crp                Float?
  creatinine         Float
  hemoglobin         Float?
  albumin            Float?
  sodium             Float?
  potassium          Float?
  bilirubin          Float?
  bloodCultureResult String?  @default("Pending")
  reportFileUrl      String?
  uploadedById       String?
  uploadedBy         User?    @relation("LabUploader", fields: [uploadedById], references: [id])
  timestamp          DateTime @default(now())

  @@index([patientId, timestamp])
}

model AIPrediction {
  id                  String          @id @default(uuid())
  patientId           String
  patient             Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  riskLevel           SepsisRiskLevel
  confidenceScore     Float
  sepsisProbability   Float
  deteriorationWindow Float
  qSofaScore          Int
  sofaScore           Int
  shapExplanationJson String
  recommendedActions  String
  dataQualityScore    Float           @default(95.0)
  modelVersion        String          @default("v3.2-XGBoost")
  timestamp           DateTime        @default(now())

  @@index([patientId, timestamp])
  @@index([riskLevel])
}

model AlertEscalation {
  id               String          @id @default(uuid())
  patientId        String
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  alertType        String          @default("SEPSIS_EARLY_WARNING")
  priority         SepsisRiskLevel @default(CRITICAL)
  severity         SepsisRiskLevel @default(CRITICAL)
  title            String
  description      String
  status           String          @default("active")
  escalationLevel  String          @default("Nurse")
  acknowledgedTime DateTime?
  closedTime       DateTime?
  createdAt        DateTime        @default(now())

  @@index([patientId, status])
  @@index([priority, status])
}

model Notification {
  id               String           @id @default(uuid())
  recipientId      String
  recipient        User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  title            String
  message          String
  notificationType NotificationType @default(CRITICAL_ALERT)
  readStatus       Boolean          @default(false)
  sentTime         DateTime         @default(now())

  @@index([recipientId, readStatus])
}

model Medication {
  id             String    @id @default(uuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  drugName       String
  dosage         String
  frequency      String
  route          String
  startDate      DateTime  @default(now())
  endDate        DateTime?
  prescribedById String?
  prescribedBy   User?     @relation("PrescribingDoctor", fields: [prescribedById], references: [id])
  status         String    @default("Active")
  createdAt      DateTime  @default(now())

  @@index([patientId, status])
}

model ClinicalNote {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("NoteAuthor", fields: [authorId], references: [id])
  observation String
  timestamp   DateTime @default(now())

  @@index([patientId, timestamp])
}

model Document {
  id           String   @id @default(uuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title        String
  docType      DocType  @default(LAB_REPORT)
  fileUrl      String
  fileSize     String   @default("1.2 MB")
  uploadedById String?
  uploadedBy   User?    @relation("DocUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([patientId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String
  ipAddress String
  device    String   @default("Web Dashboard")
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@index([action])
}
